{:paths
 ["src" "resources"]

 :deps
 {ai.altertable/altertable-lakehouse-java
  {:mvn/version "0.1.3"}}

 :mvn/repos
 {"opensaml" {:url "https://build.shibboleth.net/nexus/content/repositories/releases/"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1" :git/sha "dfb30dd"}
    io.github.metabase/metabase
    {:git/tag "v0.61.2" :git/sha "0c64e27763e13123766434979ed3e41f0cd185bc"}}
   ;; Metabase replaces the Maven redux artifact with a patched Git fork.
   ;; As a transitive dependency, tools.deps needs the same explicit override.
   :override-deps
   {metosin/malli
    {:git/url "https://github.com/metabase/malli"
     :git/sha "b4a2d78647a049870b316753d7aae7fb4ade3ae5"}
    redux/redux
    {:git/url "https://github.com/metabase/redux"
     :git/sha "4a37feaf817a2a6b5ef688c927f6fd4375964433"}}
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["test"]}}}}
